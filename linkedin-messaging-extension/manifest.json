{
  "manifest_version": 3,
  "name": "LinkedIn Message Manager",
  "version": "1.0.0",
  "description": "Tag, track, and follow up on LinkedIn conversations.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/messaging/*"],
      "js": [
        "utils/domHelpers.js",
        "utils/conversationId.js",
        "utils/fuzzySearch.js",
        "utils/storage.js",
        "components/SearchResults.js",
        "components/Sidebar.js",
        "components/InboxOverlay.js",
        "components/TagModal.js",
        "components/NoteModal.js",
        "components/ReminderModal.js",
        "contentScript.js"
      ],
      "css": [
        "styles/sidebar.css",
        "styles/modals.css",
        "styles/pills.css",
        "styles/animations.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
